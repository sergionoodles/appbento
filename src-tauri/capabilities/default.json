{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-library-list",
    "allow-library-icon",
    "allow-library-set-icon",
    "allow-library-scan",
    "allow-library-integrate",
    "allow-library-launch",
    "allow-library-configure",
    "allow-sandbox-status",
    "allow-library-remove",
    "allow-updates-check",
    "allow-updates-check-all",
    "allow-updates-configure",
    "allow-updates-install",
    "allow-configuration-export",
    "allow-configuration-read",
    "allow-configuration-restore",
    "allow-configuration-preferences",
    "allow-settings-get",
    "allow-settings-set"
  ]
}
